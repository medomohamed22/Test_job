# Same keys as local.properties.example; on CI use env vars MAPS_API_KEY, GEMINI_CLOUD_MODEL, GOOGLE_SERVICES_JSON (base64).
sdk.dir=/path/to/Android/sdk
# Android-restricted Maps Platform key (Maps SDK for Android, Places API (New), Routes API)
tripmate.mapsApiKey=
# Cloud Gemini model used by Firebase AI Logic
tripmate.geminiCloudModel=gemini-3.5-flash
